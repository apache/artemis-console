{
  "name": "artemis-console-app",
  "version": "1.8.0",
  "description": "Artemis Console",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production && yarn replace-version && yarn replace-doc-version",
    "replace-version": "node ../scripts/replace-version.mjs './app/build/static/js/*.js'",
    "replace-doc-version": "node ../scripts/replace-version.mjs ./app/build/hawtconfig.json"
  },
  "dependencies": {
    "@hawtio/react": "2.4.0-pre.1",
    "@monaco-editor/react": "^4.7.0",
    "@patternfly/patternfly": "^6.6.1",
    "@patternfly/react-charts": "^8.6.1",
    "@patternfly/react-code-editor": "^6.6.2",
    "@patternfly/react-core": "^6.6.2",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-styles": "^6.6.1",
    "@patternfly/react-table": "^6.6.2",
    "@patternfly/react-tokens": "^6.6.1",
    "@patternfly/react-topology": "^6.6.0",
    "artemis-console-plugin": "workspace:*",
    "d3": "^7.9.0",
    "monaco-editor": "~0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@hawtio/backend-middleware": "^1.1.0",
    "@swc/core": "^1.16.18",
    "@types/react": "^18.3.31",
    "body-parser": "^2.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "monaco-editor-webpack-plugin": "^7.1.1",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "source-map-loader": "^5.0.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
